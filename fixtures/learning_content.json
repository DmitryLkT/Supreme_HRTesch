[
  {
    "model": "onboarding.module",
    "pk": 2,
    "fields": {
      "title": "\u041f\u0443\u043b\u044c\u0441 \u043e\u043f\u0440\u043e\u0441",
      "description": "\u041e\u043f\u0440\u043e\u0441 \u0434\u043b\u044f \u0432\u043d\u043e\u0432\u044c \u043f\u0440\u0438\u0431\u044b\u0432\u0448\u0438\u0445 \u0441\u043e\u0442\u0440\u0443\u0434\u043d\u0438\u043a\u043e\u0432",
      "order": 0,
      "is_published": false,
      "content": ""
    }
  },
  {
    "model": "onboarding.question",
    "pk": 2,
    "fields": {
      "module": 2,
      "text": "\u042f \u043f\u043e\u043d\u0438\u043c\u0430\u044e, \u043a\u0430\u043a\u0438\u0435 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u044b \u043e\u0442 \u043c\u0435\u043d\u044f \u0436\u0434\u0443\u0442 \u0432 \u0431\u043b\u0438\u0436\u0430\u0439\u0448\u0438\u0435 30 \u0434\u043d\u0435\u0439.",
      "order": 1
    }
  },
  {
    "model": "onboarding.question",
    "pk": 3,
    "fields": {
      "module": 2,
      "text": "\u042f \u0437\u043d\u0430\u044e, \u043f\u043e \u043a\u0430\u043a\u0438\u043c \u043a\u0440\u0438\u0442\u0435\u0440\u0438\u044f\u043c \u043e\u0446\u0435\u043d\u044f\u0442 \u043c\u043e\u044e \u0440\u0430\u0431\u043e\u0442\u0443 \u043d\u0430 \u0438\u0441\u043f\u044b\u0442\u0430\u0442\u0435\u043b\u044c\u043d\u043e\u043c \u0441\u0440\u043e\u043a\u0435.",
      "order": 2
    }
  },
  {
    "model": "onboarding.question",
    "pk": 4,
    "fields": {
      "module": 2,
      "text": "\u042f \u0437\u043d\u0430\u044e, \u043a\u0442\u043e \u043f\u0440\u0438\u043d\u0438\u043c\u0430\u0435\u0442 \u0440\u0435\u0448\u0435\u043d\u0438\u044f \u043f\u043e \u043c\u043e\u0438\u043c \u043e\u0441\u043d\u043e\u0432\u043d\u044b\u043c \u0437\u0430\u0434\u0430\u0447\u0430\u043c.",
      "order": 0
    }
  },
  {
    "model": "onboarding.question",
    "pk": 5,
    "fields": {
      "module": 2,
      "text": "\u042f \u0437\u043d\u0430\u044e, \u043a \u043a\u043e\u043c\u0443 \u0438\u0434\u0442\u0438, \u0435\u0441\u043b\u0438 \u043d\u0435 \u043f\u043e\u043d\u0438\u043c\u0430\u044e, \u0447\u0442\u043e \u0434\u0435\u043b\u0430\u0442\u044c.",
      "order": 4
    }
  },
  {
    "model": "onboarding.question",
    "pk": 6,
    "fields": {
      "module": 2,
      "text": "\u042f \u0443\u0432\u0435\u0440\u0435\u043d(\u0430), \u0447\u0442\u043e \u0441\u043f\u0440\u0430\u0432\u043b\u044e\u0441\u044c \u0441 \u043e\u0441\u043d\u043e\u0432\u043d\u044b\u043c\u0438 \u0437\u0430\u0434\u0430\u0447\u0430\u043c\u0438 \u0440\u043e\u043b\u0438.",
      "order": 5
    }
  },
  {
    "model": "onboarding.question",
    "pk": 7,
    "fields": {
      "module": 2,
      "text": "\u0423 \u043c\u0435\u043d\u044f \u0435\u0441\u0442\u044c \u0434\u043e\u0441\u0442\u0443\u043f\u044b \u0438 \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u044b, \u0447\u0442\u043e\u0431\u044b \u0440\u0430\u0431\u043e\u0442\u0430\u0442\u044c \u0431\u0435\u0437 \u043e\u0436\u0438\u0434\u0430\u043d\u0438\u044f.",
      "order": 6
    }
  },
  {
    "model": "onboarding.question",
    "pk": 8,
    "fields": {
      "module": 2,
      "text": "\u042f \u043c\u043e\u0433\u0443 \u043e\u0431\u044a\u044f\u0441\u043d\u0438\u0442\u044c \u043a\u043e\u043b\u043b\u0435\u0433\u0435, \u043a\u0430\u043a \u0443 \u043d\u0430\u0441 \u043f\u0440\u043e\u0445\u043e\u0434\u0438\u0442 \u043a\u043b\u044e\u0447\u0435\u0432\u043e\u0439 \u043f\u0440\u043e\u0446\u0435\u0441\u0441 \u043c\u043e\u0435\u0439 \u0440\u043e\u043b\u0438.",
      "order": 7
    }
  },
  {
    "model": "onboarding.question",
    "pk": 9,
    "fields": {
      "module": 2,
      "text": "\u041a\u043e\u043b\u043b\u0435\u0433\u0438 \u043e\u0442\u0432\u0435\u0447\u0430\u044e\u0442 \u043d\u0430 \u043c\u043e\u0438 \u0432\u043e\u043f\u0440\u043e\u0441\u044b \u0431\u0435\u0437 \u0440\u0430\u0437\u0434\u0440\u0430\u0436\u0435\u043d\u0438\u044f.",
      "order": 8
    }
  },
  {
    "model": "onboarding.question",
    "pk": 10,
    "fields": {
      "module": 2,
      "text": "\u0412 \u043a\u043e\u043c\u043f\u0430\u043d\u0438\u0438 \u0435\u0441\u0442\u044c \u0447\u0435\u043b\u043e\u0432\u0435\u043a, \u0441 \u043a\u043e\u0442\u043e\u0440\u044b\u043c \u044f \u043c\u043e\u0433\u0443 \u0433\u043e\u0432\u043e\u0440\u0438\u0442\u044c \u043e\u0442\u043a\u0440\u043e\u0432\u0435\u043d\u043d\u043e.",
      "order": 9
    }
  },
  {
    "model": "onboarding.question",
    "pk": 11,
    "fields": {
      "module": 2,
      "text": "\u041c\u0435\u043d\u044f \u043f\u0440\u0438\u043d\u0438\u043c\u0430\u044e\u0442 \u043a\u0430\u043a \u0447\u043b\u0435\u043d\u0430 \u043a\u043e\u043c\u0430\u043d\u0434\u044b.",
      "order": 10
    }
  },
  {
    "model": "onboarding.question",
    "pk": 12,
    "fields": {
      "module": 2,
      "text": "\u042f \u043f\u043e\u043d\u0438\u043c\u0430\u044e, \u043a\u0430\u043a\u043e\u0435 \u043f\u043e\u0432\u0435\u0434\u0435\u043d\u0438\u0435 \u0437\u0434\u0435\u0441\u044c \u043f\u043e\u043e\u0449\u0440\u044f\u0435\u0442\u0441\u044f, \u0430 \u043a\u0430\u043a\u043e\u0435 \u043d\u0435\u0442, \u0432\u043a\u043b\u044e\u0447\u0430\u044f \u043d\u0435\u043f\u0438\u0441\u0430\u043d\u044b\u0435 \u043f\u0440\u0430\u0432\u0438\u043b\u0430.",
      "order": 11
    }
  },
  {
    "model": "onboarding.question",
    "pk": 13,
    "fields": {
      "module": 2,
      "text": "\u0422\u043e, \u0447\u0442\u043e \u044f \u0432\u0438\u0436\u0443 \u043d\u0430 \u043f\u0440\u0430\u043a\u0442\u0438\u043a\u0435, \u0441\u043e\u0432\u043f\u0430\u0434\u0430\u0435\u0442 \u0441 \u0442\u0435\u043c, \u0447\u0442\u043e \u043c\u043d\u0435 \u0440\u0430\u0441\u0441\u043a\u0430\u0437\u044b\u0432\u0430\u043b\u0438 \u043f\u0440\u0438 \u043d\u0430\u0439\u043c\u0435.",
      "order": 12
    }
  },
  {
    "model": "onboarding.question",
    "pk": 14,
    "fields": {
      "module": 2,
      "text": "\u041d\u0430 \u0440\u0430\u0431\u043e\u0442\u0435 \u044f \u043c\u043e\u0433\u0443 \u043f\u0440\u043e\u044f\u0432\u043b\u044f\u0442\u044c \u0441\u0432\u043e\u0438 \u0441\u0438\u043b\u044c\u043d\u044b\u0435 \u0441\u0442\u043e\u0440\u043e\u043d\u044b.",
      "order": 13
    }
  },
  {
    "model": "onboarding.question",
    "pk": 15,
    "fields": {
      "module": 2,
      "text": "\u0412 \u044d\u0442\u043e\u043c \u043c\u0435\u0441\u044f\u0446\u0435 \u044f \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u044e \u0441\u0435\u0431\u044f \u043f\u0435\u0440\u0435\u0433\u0440\u0443\u0436\u0435\u043d\u043d\u044b\u043c(\u043e\u0439).",
      "order": 14
    }
  },
  {
    "model": "onboarding.question",
    "pk": 16,
    "fields": {
      "module": 2,
      "text": "\u042f \u0440\u0430\u0441\u0441\u0447\u0438\u0442\u044b\u0432\u0430\u044e \u0440\u0430\u0431\u043e\u0442\u0430\u0442\u044c \u0437\u0434\u0435\u0441\u044c \u0447\u0435\u0440\u0435\u0437 \u0433\u043e\u0434.",
      "order": 15
    }
  },
  {
    "model": "onboarding.question",
    "pk": 17,
    "fields": {
      "module": 2,
      "text": "\u042f \u0437\u043d\u0430\u044e, \u0432 \u043a\u0430\u043a\u0438\u0435 \u0447\u0430\u0441\u044b \u043c\u0435\u043d\u044f \u0436\u0434\u0443\u0442 \u043e\u043d\u043b\u0430\u0439\u043d \u0438 \u043a\u0430\u043a \u0441\u043e\u0433\u043b\u0430\u0441\u043e\u0432\u044b\u0432\u0430\u0442\u044c \u0441\u0440\u043e\u0447\u043d\u043e\u0435 \u0432\u043d\u0435 \u043d\u0438\u0445.",
      "order": 16
    }
  },
  {
    "model": "onboarding.question",
    "pk": 18,
    "fields": {
      "module": 2,
      "text": "\u041c\u043d\u0435 \u043f\u043e\u043d\u044f\u0442\u043d\u044b \u043e\u0441\u043e\u0431\u0435\u043d\u043d\u043e\u0441\u0442\u0438 \u043e\u0431\u0449\u0435\u043d\u0438\u044f \u0441 \u043a\u043e\u043b\u043b\u0435\u0433\u0430\u043c\u0438 \u0438\u0437 \u0434\u0440\u0443\u0433\u0438\u0445 \u0441\u0442\u0440\u0430\u043d.",
      "order": 17
    }
  },
  {
    "model": "onboarding.question",
    "pk": 19,
    "fields": {
      "module": 2,
      "text": "\u041f\u043e \u0434\u043e\u0433\u043e\u0432\u043e\u0440\u0443, \u043d\u0430\u043b\u043e\u0433\u0430\u043c \u0438 \u043e\u0442\u043f\u0443\u0441\u043a\u0430\u043c \u043c\u043d\u0435 \u0432\u0441\u0451 \u043f\u043e\u043d\u044f\u0442\u043d\u043e \u0438\u043b\u0438 \u044f \u0437\u043d\u0430\u044e, \u043a \u043a\u043e\u043c\u0443 \u043e\u0431\u0440\u0430\u0442\u0438\u0442\u044c\u0441\u044f.",
      "order": 18
    }
  },
  {
    "model": "onboarding.question",
    "pk": 20,
    "fields": {
      "module": 2,
      "text": "\u041d\u0430 \u043f\u0440\u043e\u0448\u043b\u043e\u0439 \u043d\u0435\u0434\u0435\u043b\u0435 \u044f \u043e\u0431\u0449\u0430\u043b\u0441\u044f(\u043b\u0430\u0441\u044c) \u0441 \u043a\u043e\u043b\u043b\u0435\u0433\u0430\u043c\u0438 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u043f\u043e \u0440\u0430\u0431\u043e\u0447\u0438\u043c \u0437\u0430\u0434\u0430\u0447\u0430\u043c.",
